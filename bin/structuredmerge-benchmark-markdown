#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'
require 'optparse'

def table(headers, rows)
  escape = ->(value) { value.to_s.gsub('|', '\\|').gsub("\n", '<br>') }
  [
    "| #{headers.map { |header| escape.call(header) }.join(' | ')} |",
    "| #{headers.map { '---' }.join(' | ')} |",
    *rows.map { |row| "| #{row.map { |value| escape.call(value) }.join(' | ')} |" }
  ].join("\n")
end

def gate_result(value)
  value.to_s == 'pass' ? 'PASS' : 'FAIL'
end

def format_duration(nanoseconds)
  return 'n/a' unless nanoseconds

  format('%.3fs', nanoseconds.to_f / 1_000_000_000)
end

def format_percent(value)
  value ? format('%.2f%%', value) : 'n/a'
end

def outcome_summary(outcomes)
  outcomes.keys.sort.map { |outcome| "#{outcome}=#{outcomes.fetch(outcome)}" }.join(', ')
end

options = {marker: 'structuredmerge-benchmark-report'}
parser = OptionParser.new do |opts|
  opts.banner = 'Usage: structuredmerge-benchmark-markdown REPORT|- [MARKDOWN|-] [options]'
  opts.separator ''
  opts.separator 'Render an aggregate StructuredMerge benchmark JSON report as Markdown tables.'
  opts.separator ''
  opts.separator 'Arguments:'
  opts.separator '  REPORT|-       JSON report path, or - to read JSON from standard input.'
  opts.separator '  MARKDOWN|-     destination path, or - to write Markdown to standard output.'
  opts.separator '                  Defaults to standard output.'
  opts.separator ''
  opts.separator 'Options:'
  opts.on('--marker NAME', 'managed block marker name') { |value| options[:marker] = value }
  opts.on('-h', '--help', 'show this help') do
    puts opts
    puts <<~TEXT

      Examples:
        structuredmerge-benchmark report --profile micro --workers 4 | structuredmerge-benchmark-markdown - benchmark-results.md
        structuredmerge-benchmark-markdown report.json benchmark-results.md
        structuredmerge-benchmark-markdown report.json --marker nightly-report

      The destination is updated between HTML markers named
      structuredmerge-benchmark-report:start and :end. Existing content outside
      those markers is preserved. Re-running the command is idempotent.
    TEXT
    exit 0
  end
end

if ARGV.empty?
  puts parser
  exit 0
end

begin
  parser.parse!(ARGV)
  input_path = ARGV.shift || '-'
  output_path = ARGV.shift || '-'
  report = JSON.parse(input_path == '-' ? $stdin.read : File.binread(input_path))
  coverage = report.dig('dimensions', 'coverage') || {}

  markdown = []
  markdown << "## StructuredMerge Benchmark"
  markdown << ''
  markdown << table(
    %w[Property Value],
    [
      ['Profile', report.dig('selection', 'profile') || 'unknown'],
      ['Selection mode', report.dig('selection', 'selection_mode') || 'unknown'],
      ['Competitor policy', report.dig('selection', 'competitor_policy') || 'none'],
      ['Corpus', report['corpus_id'] || 'unknown'],
      ['Selected cases', coverage['selected_cases']],
      ['Executed cases', coverage['executed_candidate_cases']],
      ['Unsupported cases', coverage['unsupported_case_ids']&.length || 0],
      ['Changed paths', Array(report.dig('selection', 'changed_paths')).length],
      ['Hard gates', report['hard_gate_failed'] ? 'FAIL' : 'PASS']
    ]
  )
  selection = report['selection'] || {}
  selected_case_ids = Array(selection['selected_case_ids'])
  excluded_case_ids = Array(selection['excluded_case_ids'])
  markdown << ''
  markdown << '### Selection'
  markdown << ''
  markdown << table(
    ['Group', 'Count'],
    [
      ['Selected', selected_case_ids.length],
      ['Directly affected', Array(selection['direct_cases']).length],
      ['Deterministic neighbors', Array(selection.dig('neighbor_sample', 'selected_case_ids')).length],
      ['Excluded', excluded_case_ids.length]
    ]
  )
  markdown << ''
  markdown << '<details>'
  markdown << '<summary>Selected case IDs</summary>'
  markdown << ''
  markdown << table(['Case ID'], selected_case_ids.map { |case_id| [case_id] })
  markdown << ''
  markdown << '</details>'
  markdown << ''
  markdown << '### Quality Gates'
  markdown << ''
  markdown << table(
    %w[Gate Result Details],
    [
      ['Safety', gate_result(report.dig('dimensions', 'safety', 'gate')), "eligible: #{report.dig('dimensions', 'safety', 'eligible') || 0}"],
      ['Preservation', gate_result(report.dig('dimensions', 'preservation', 'gate')), "eligible: #{report.dig('dimensions', 'preservation', 'eligible') || 0}"],
      ['Reliability', gate_result(report.dig('dimensions', 'reliability', 'gate')), "errors: #{report.dig('dimensions', 'reliability', 'error_result_ids')&.length || 0}"],
      ['Coverage', coverage['unsupported_case_ids']&.empty? ? 'PASS' : 'REVIEW', "unsupported: #{coverage['unsupported_case_ids']&.length || 0}"]
    ]
  )
  markdown << ''
  markdown << '### Effectiveness'
  markdown << ''
  effectiveness = report.dig('dimensions', 'effectiveness') || {}
  markdown << table(
    %w[Outcome Count],
    effectiveness.keys.sort.map { |outcome| [outcome, effectiveness[outcome]] }
  )
  performance = report.dig('dimensions', 'performance') || {}
  unless performance.empty?
    markdown << ''
    markdown << '### Performance'
    markdown << ''
    markdown << table(
      ['Adapter', 'Samples', 'Total'],
      performance.keys.sort.map do |adapter|
        evidence = performance.fetch(adapter)
        [adapter, evidence['samples'], format_duration(evidence['total_ns'])]
      end
    )
  end
  competitive = report.dig('dimensions', 'competitive') || {}
  adapters = competitive['adapters'] || {}
  markdown << ''
  markdown << '### Competitive Comparison'
  markdown << ''
  if adapters.empty?
    markdown << 'No competitor adapters were configured for this run.'
    markdown << ''
    markdown << 'Use the `competitive` profile with an adapter option such as `--mergiraf /path/to/mergiraf`.'
  else
    markdown << 'StructuredMerge candidate gates are reported above. The table below contains results from explicitly configured competitors.'
    markdown << ''
    markdown << table(
      ['Adapter', 'Selected', 'Supported', 'Eligible', 'Coverage', 'Outcomes'],
      adapters.keys.sort.map do |adapter|
        evidence = adapters.fetch(adapter)
        [adapter, evidence['selected_cases'], evidence['supported_cases'],
         evidence['eligible_cases'], format_percent(evidence.dig('coverage', 'percent')),
         outcome_summary(evidence['outcomes'] || {})]
      end
    )
  end
  generated = markdown.join("\n")

  if output_path == '-'
    puts generated
  else
    existing = File.file?(output_path) ? File.binread(output_path) : ''
    open_marker = "<!-- #{options[:marker]}:start -->"
    close_marker = "<!-- #{options[:marker]}:end -->"
    block = [open_marker, generated, close_marker].join("\n")
    pattern = /#{Regexp.escape(open_marker)}.*?#{Regexp.escape(close_marker)}/m
    updated = if existing.match?(pattern)
                existing.sub(pattern, block)
              elsif existing.empty?
                "#{block}\n"
              else
                "#{existing.rstrip}\n\n#{block}\n"
              end
    File.binwrite(output_path, updated) unless updated == existing
  end
rescue JSON::ParserError, Errno::ENOENT, OptionParser::ParseError => e
  warn "structuredmerge-benchmark-markdown: #{e.message}"
  exit 2
end
