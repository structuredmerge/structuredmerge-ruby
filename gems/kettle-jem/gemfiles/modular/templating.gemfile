# frozen_string_literal: true

structuredmerge_remote = ENV.fetch("STRUCTUREDMERGE_DEV", "false").casecmp("false").zero?
kettle_remote = ENV.fetch("KETTLE_DEV_DEV", "false").casecmp("false").zero?

# This selects the dependency source only. Runtime parser/provider selection
# remains explicit through TreeHaver and the family provider registries.
structuredmerge_core_dev = ENV.fetch("STRUCTUREDMERGE_CORE_DEV", "").strip
if !structuredmerge_core_dev.empty? && !%w[false 0 no off].include?(structuredmerge_core_dev.downcase)
  structuredmerge_core_root = if %w[true 1 yes on].include?(structuredmerge_core_dev.downcase)
    File.join(Dir.home, "src/my/structuredmerge/structuredmerge")
  else
    File.expand_path(structuredmerge_core_dev, Dir.home)
  end
  gem "structuredmerge-core", path: File.join(structuredmerge_core_root, "packages/ruby")
elsif ENV.fetch("STRUCTUREDMERGE_CORE_PUBLISHED", "false").casecmp("true").zero?
  gem "structuredmerge-core", "~> 0.2"
end

tslp_dev = ENV.fetch("TSLP_DEV", nil).to_s
tslp_dev = nil if tslp_dev.empty? || %w[false 0 no off].include?(tslp_dev.downcase)
if structuredmerge_remote || !tslp_dev.to_s.empty?
  # Keep one Bundler declaration so the local debugging override cannot be
  # mistaken for a second dependency declaration.
  tslp_requirements = if tslp_dev.to_s.empty?
    ["~> 1.16", ">= 1.16.2"]
  else
    [{path: tslp_dev}]
  end
  gem "tree_sitter_language_pack", *tslp_requirements
end

if structuredmerge_remote
end

if kettle_remote
  # Template/plugin checks for released installs.
  gem "kettle-drift", "~> 1.0", ">= 1.0.19", require: false
end

# Set STRUCTUREDMERGE_DEV=/path/to/structuredmerge/ruby/gems for local development with path-based dependencies.
# When false (default / CI), released kettle-jem brings merge gems and parser dependencies.
# Local path overrides bring the same dependencies from sibling gemspecs.
#
# Set KETTLE_DEV_DEV=/path/to/my for local development with Kettle plugin gems.
# When false (default / CI), released Kettle plugin gems are used.
eval_gemfile "templating_local.gemfile" unless structuredmerge_remote && kettle_remote
