# frozen_string_literal: true

# Local path overrides for development.
# Loaded by the associated non-local gemfile when KETTLE_DEV_DEV != "false".

# Bootstrapping nomono here cannot rely on a plain `gem "nomono", ...` line.
# Bundler records that dependency during Gemfile evaluation, but it does not
# activate that exact version before the immediate `require "nomono/bundler"`.
nomono_activation_requirements = ["~> 1.1", ">= 1.1.17"]
nomono_requirement = Gem::Requirement.new(nomono_activation_requirements)
nomono_already_activated = Gem.loaded_specs["nomono"]
nomono_lockfile = File.expand_path("../../Gemfile.lock", __dir__)
nomono_locked_spec = nil
if File.file?(nomono_lockfile)
  require "bundler"
  nomono_locked_spec = Bundler::LockfileParser
    .new(Bundler.read_file(nomono_lockfile))
    .specs
    .find { |spec| spec.name == "nomono" }
end
nomono_local_loader = if nomono_locked_spec && nomono_locked_spec.source.is_a?(Bundler::Source::Path)
  File.expand_path(
    File.join(nomono_locked_spec.source.path, "lib", "nomono", "bundler"),
    File.dirname(nomono_lockfile)
  )
end
if nomono_local_loader && File.file?("#{nomono_local_loader}.rb")
  require nomono_local_loader
else
  if !nomono_already_activated || !nomono_requirement.satisfied_by?(nomono_already_activated.version)
    nomono_locked_installed = nomono_locked_spec &&
      Gem::Specification.find_all_by_name("nomono").any? { |spec| spec.version == nomono_locked_spec.version }
    nomono_locked = nomono_locked_spec &&
      nomono_locked_installed &&
      nomono_requirement.satisfied_by?(nomono_locked_spec.version)
    nomono_activation_requirements = ["= #{nomono_locked_spec.version}"] if nomono_locked
  end
  Kernel.send(:gem, "nomono", *nomono_activation_requirements)
  require "nomono/bundler"
end

local_gem_requirements = {"addressable" => [">= 2.8", "< 3"], "anonymous_loader" => ["~> 0.1", ">= 0.1.5"], "appraisal2" => ["~> 3.2", ">= 3.2.6"], "ast-crispr-markdown-markly" => ["~> 7.1", ">= 7.1.8"], "ast-crispr-ruby-prism" => ["~> 7.1", ">= 7.1.10"], "ast-merge" => ["~> 7.1", ">= 7.1.8"], "ast-template" => ["~> 7.1", ">= 7.1.11"], "bash-merge" => ["~> 7.1", ">= 7.1.8"], "bundler-audit" => ["~> 0.9.3"], "citrus-toml-merge" => ["~> 7.1", ">= 7.1.8"], "dotenv-merge" => ["~> 7.1", ">= 7.1.8"], "gitmoji-regex" => ["~> 2.0", ">= 2.0.15"], "json" => ["~> 2.0", ">= 2.21.2"], "json-merge" => ["~> 7.1", ">= 7.1.8"], "kettle-changelog" => ["~> 1.0", ">= 1.0.15"], "kettle-deps-floor" => ["~> 0.1", ">= 0.1.0"], "kettle-dev" => ["~> 3.1", ">= 3.1.26"], "kettle-gha-pins" => ["~> 0.3", ">= 0.3.14"], "kettle-ndjson" => ["~> 0.1", ">= 0.1.13"], "kettle-rb" => ["~> 0.1", ">= 0.1.19"], "kettle-test" => ["~> 2.0", ">= 2.0.29"], "markdown-merge" => ["~> 7.1", ">= 7.1.8"], "markly-merge" => ["~> 7.1", ">= 7.1.8"], "parslet" => ["~> 2.0"], "prism-merge" => ["~> 7.1", ">= 7.1.8"], "psych-merge" => ["~> 7.1", ">= 7.1.8"], "rake" => ["~> 13.0"], "rbs" => [">= 3.10"], "rbs-merge" => ["~> 7.1", ">= 7.1.8"], "require_bench" => ["~> 1.0", ">= 1.0.4"], "ruby-merge" => ["~> 7.1", ">= 7.1.8"], "ruby-progressbar" => ["~> 1.13"], "stone_checksums" => ["~> 1.0", ">= 1.0.9"], "token-resolver" => ["~> 2.0", ">= 2.0.10"], "toml-merge" => ["~> 7.1", ">= 7.1.8"], "toml-rb" => ["~> 4.2"], "tree_haver" => ["~> 7.1", ">= 7.1.8"], "turbo_tests2" => ["~> 4.0", ">= 4.0.0"], "version_gem" => ["~> 1.1", ">= 1.1.17"], "yaml-merge" => ["~> 7.1", ">= 7.1.8"]}

local_gems = %w[kettle-deps-floor kettle-dev kettle-family kettle-rb kettle-test kettle-soup-cover kettle-changelog kettle-drift]
kettle_dev_nomono_options = {
  prefix: "KETTLE_DEV",
  path_env: "KETTLE_DEV_DEV",
  vendored_gems_env: "VENDORED_GEMS",
  vendor_gem_dir_env: "VENDOR_GEM_DIR",
  debug_env: "KETTLE_DEV_DEBUG",
  root: ["src", "my", "kettle-dev"]
}

# export KETTLE_DEV_DEV=/path/to/my
platform :mri do
  local_gems_to_eval = local_gems - %w[]

  eval_nomono_gems(
    gems: local_gems_to_eval,
    requirements: local_gem_requirements,
    **kettle_dev_nomono_options
  )

  if ENV.fetch("GALTZO_FLOSS_DEV", "false").casecmp("false") != 0
    eval_nomono_gems(
      gems: %w[turbo_tests2],
      requirements: local_gem_requirements,
      prefix: "GALTZO_FLOSS",
      path_env: "GALTZO_FLOSS_DEV",
      vendored_gems_env: "GALTZO_FLOSS_VENDORED_GEMS",
      vendor_gem_dir_env: "GALTZO_FLOSS_VENDOR_GEM_DIR",
      debug_env: "GALTZO_FLOSS_DEBUG"
    )
  end
end
