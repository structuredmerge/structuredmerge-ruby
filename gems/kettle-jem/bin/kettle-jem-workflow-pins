#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "optparse"
require "pathname"

require "kettle/gha/pins"
# Repository-local executable must boot from the unreleased source checkout.
# rubocop:disable Packaging/RequireRelativeHardcodingLib -- Installed execution is not available while maintaining templates.
require_relative "../lib/kettle/jem"
# rubocop:enable Packaging/RequireRelativeHardcodingLib

# Repository-local maintenance tool for updating kettle-jem workflow template pins.
class KettleJemWorkflowPins
  VALID_UPGRADE_LEVELS = %w[major minor patch].freeze
  DEFAULT_UPGRADE_LEVEL = "major"
  DEFAULT_PROJECT_ROOT = File.expand_path("..", __dir__)
  CHANGELOG_KEY = "kettle-jem-workflow-pins"
  LEGACY_CHANGELOG_PREFIX = "Update pinned GitHub Actions in kettle-jem templates:"
  PIN_PATTERN = %r{(([-\w.]+/[-\w.]+(?:/[-\w.]+)*)@[0-9a-f]{40}[ \t]*#[ \t]*[^\s"',]+)}

  def initialize(project_root:, env: ENV, options: {})
    @project_root = File.expand_path(project_root)
    @env = env
    @options = {
      write: false,
      check: false,
      commit: true,
      changelog: true,
      json: false,
      upgrade: DEFAULT_UPGRADE_LEVEL
    }.merge(options.transform_keys(&:to_sym))
  end

  def self.run(argv = ARGV, env: ENV, out: $stdout, err: $stderr)
    options = parse_options(argv)
    result = new(project_root: options.delete(:project_root), env: env, options: options).run
    if options[:json]
      out.puts(JSON.pretty_generate(result))
    else
      out.puts("workflow-pins: mode=#{result.fetch(:mode)} upgrade=#{result.fetch(:upgrade)}")
      out.puts("workflow-pins: #{result.fetch(:updates)} update#{"s" unless result.fetch(:updates) == 1}")
      result.fetch(:changes, []).each do |change|
        out.puts(
          "  #{change.fetch(:action)} #{pin_label(change.fetch(:old_version), change.fetch(:old_ref))} -> " \
            "#{pin_label(change.fetch(:new_version), change.fetch(:new_ref))}"
        )
      end
      if result[:changelog]
        out.puts("changelog: #{result.fetch(:changelog).fetch(:status)}")
      end
      out.puts("commit: #{result.fetch(:commit).fetch(:status)}") if result[:commit]
      if !result.fetch(:mode).to_s.eql?("write") && result.fetch(:updates).positive?
        out.puts("hint: rerun with --write --upgrade #{result.fetch(:upgrade)} to apply and commit these updates")
      end
    end
    0
  rescue OptionParser::ParseError, ArgumentError => error
    err.puts(error.message)
    err.puts(parser)
    2
  rescue => error
    err.puts("#{error.class}: #{error.message}")
    1
  end

  def self.parse_options(argv)
    options = {
      project_root: DEFAULT_PROJECT_ROOT,
      write: false,
      check: false,
      commit: true,
      changelog: true,
      json: false,
      upgrade: DEFAULT_UPGRADE_LEVEL
    }
    parser.parse!(argv, into: options)
    options[:project_root] = argv.shift || DEFAULT_PROJECT_ROOT
    raise OptionParser::InvalidArgument, "Expected at most one PROJECT_ROOT" unless argv.empty?

    options
  end

  def self.parser
    OptionParser.new do |opts|
      opts.banner = "Usage: bin/kettle-jem-workflow-pins [PROJECT_ROOT] [--json] [--write] [--check] [--commit|--no-commit] [--changelog|--no-changelog] [--upgrade LEVEL]"
      opts.on("-w", "--write", "Write updates to kettle-jem template sources.") { |value| value }
      opts.on("--check", "Fail when template workflow pins are stale.") { |value| value }
      opts.on("--[no-]commit", "Commit written updates (default with --write).") { |value| value }
      opts.on("--[no-]changelog", "Add a Changed entry with kettle-changelog (default with --write).") { |value| value }
      opts.on("--json", "Print the machine-readable report as JSON.") { |value| value }
      opts.on("--upgrade LEVEL", "Upgrade strategy: major, minor, patch (default: #{DEFAULT_UPGRADE_LEVEL})") { |value| value }
    end
  end

  def self.pin_label(version, ref)
    version = version.to_s.delete_prefix("v")
    version.empty? ? ref.to_s : "v#{version} (#{ref})"
  end

  def run
    upgrade = @options.fetch(:upgrade, DEFAULT_UPGRADE_LEVEL).to_s
    unless VALID_UPGRADE_LEVELS.include?(upgrade)
      raise ArgumentError, "Invalid --upgrade value #{upgrade.inspect}; use one of: #{VALID_UPGRADE_LEVELS.join(", ")}"
    end

    pins = Kettle::Jem.github_actions_step_pins
    raise ArgumentError, "No GitHub Actions pins found in kettle-jem" if pins.empty?

    validate_template_pin_coverage!(pins)
    report = resolve_updates(pins, upgrade)
    planned_changes = report.fetch("planned_changes", [])
    replacements = replacement_map(planned_changes, pins)
    source_pin_replacements(pins, desired_pins_by_action(pins, replacements)).each do |old_pin, replacement|
      replacements[old_pin] = replacement
    end
    changes = replacement_changes(replacements, planned_changes)
    if @options[:write] && replacements.any?
      target_paths = replacement_target_paths(replacements.values)
      target_paths << changelog_path if changelog_needed?(replacements)
      preexisting_dirty_paths = preexisting_dirty_target_paths(target_paths)
      changelog_result = add_changelog_entry(changes) if changelog_needed?(replacements)
      apply_replacements(replacements.values)
      commit_result = commit_changes(target_paths, preexisting_dirty_paths) if @options[:commit]
    end

    if @options[:check] && replacements.any?
      raise "GitHub Actions pins are stale; run bin/kettle-jem-workflow-pins --write --upgrade #{upgrade}"
    end

    {
      mode: @options[:write] ? "write" : "dry-run",
      check: !!@options[:check],
      upgrade: upgrade,
      pin_count: pins.length,
      updates: replacements.length,
      updated_actions: replacements.values.map { |replacement| replacement.fetch(:action) }.uniq.sort,
      changes: changes,
      commit: commit_result,
      changelog: changelog_result,
      planned_changes: planned_changes.select { |change| planned_change_replacement(change, pins) },
      outdated_pins: report.fetch("outdated_pins", [])
    }
  end

  private

  def template_workflow_dir
    File.join(@project_root, "lib", "kettle", "jem", "templates", ".github", "workflows")
  end

  def source_paths
    [
      File.join(@project_root, "lib", "kettle", "jem.rb"),
      *Dir.glob(File.join(template_workflow_dir, "*.yml.example")).sort
    ]
  end

  def validate_template_pin_coverage!(pins)
    source_pin_actions = source_pin_records.map { |record| record.fetch(:action) }.uniq
    missing = source_pin_actions - pins.keys
    return if missing.empty?

    raise ArgumentError, "Pinned workflow actions missing from github_actions_step_pins: #{missing.sort.join(", ")}"
  end

  def source_pin_records
    source_paths.flat_map do |path|
      File.read(path).scan(PIN_PATTERN).map do |pin, action|
        {
          path: path,
          action: action,
          pin: pin
        }
      end
    end
  end

  def resolve_updates(pins, upgrade)
    persistent_cache = Kettle::Gha::Pins::PersistentActionCache.new(
      path: @env["KETTLE_GHA_SHA_PINS_CACHE"] || Kettle::Gha::Pins::PersistentActionCache.default_path
    )
    client = Kettle::Gha::Pins::GitHubClient.new(
      token: github_token,
      api_base: Kettle::Gha::Pins::API_BASE,
      user_agent: "kettle-jem-workflow-pins",
      persistent_cache: persistent_cache,
      refresh_cache: @options[:write] || @options[:check]
    )
    action_versions = {}
    planned_changes = []
    outdated_pins = []

    pins.sort.each do |action, pin|
      parsed = parse_pin(pin)
      next unless parsed

      repo_ref = action_repo_ref(action)
      plan = Kettle::Gha::Pins.resolve_action_plan(
        cache: action_versions,
        client: client,
        repo_ref: repo_ref,
        old_ref: parsed.fetch(:ref),
        upgrade_level: upgrade
      )

      if plan[:updates]
        planned_changes << {
          "action" => repo_ref,
          "old_value" => "#{action}@#{parsed.fetch(:ref)}",
          "old_ref" => parsed.fetch(:ref),
          "old_version" => plan[:current_version],
          "new_ref" => plan[:updates][:sha],
          "new_version" => plan[:updates][:version],
          "reason" => plan[:updates][:reason]
        }
      end
      if !plan[:updates] && plan[:current_version] && !parsed[:version].to_s.empty? && parsed[:version] != plan[:current_version]
        planned_changes << {
          "action" => repo_ref,
          "old_value" => "#{action}@#{parsed.fetch(:ref)}",
          "old_ref" => parsed.fetch(:ref),
          "old_version" => parsed[:version],
          "new_ref" => parsed.fetch(:ref),
          "new_version" => plan[:current_version],
          "reason" => "update_version_comment"
        }
      end

      next unless plan[:is_outdated]

      latest_outdated = plan[:latest_outdated]
      outdated_pins << {
        "action" => repo_ref,
        "old_value" => "#{action}@#{parsed.fetch(:ref)}",
        "old_ref" => parsed.fetch(:ref),
        "old_version" => plan[:current_version],
        "new_ref" => latest_outdated ? latest_outdated[:sha] : nil,
        "new_version" => latest_outdated ? latest_outdated[:version] : nil,
        "upgrade_level" => upgrade,
        "reason" => plan[:reason]
      }
    end

    {
      "planned_changes" => planned_changes,
      "outdated_pins" => outdated_pins
    }
  end

  def parse_pin(pin)
    value = pin.to_s.strip
    old_value, comment = value.split(/[ \t]+#/, 2)
    action, separator, ref = old_value.rpartition("@")
    return nil unless separator == "@" && !action.empty? && !ref.empty?

    {action: action, ref: ref, version: comment.to_s.strip.delete_prefix("v")}
  end

  def action_repo_ref(action)
    action.to_s.split("/").first(2).join("/")
  end

  def github_token
    token = @env["GITHUB_TOKEN"] || @env["GH_TOKEN"]
    return token unless token.to_s.empty?

    stdout, _stderr, status = Open3.capture3(@env.to_hash, "gh", "auth", "token", chdir: @project_root)
    return nil unless status.success?

    token = stdout.to_s.strip
    token.empty? ? nil : token
  rescue Errno::ENOENT
    nil
  end

  def replacement_map(planned_changes, pins)
    planned_changes.each_with_object({}) do |change, replacements|
      replacement = planned_change_replacement(change, pins)
      next unless replacement

      replacements[replacement.fetch(:old_pin)] = replacement
    end
  end

  def planned_change_replacement(change, pins)
    action = pin_action_key(change, pins)
    return nil unless pins.key?(action)

    new_ref = change.fetch("new_ref").to_s
    new_version = change["new_version"].to_s
    return nil if new_ref.empty?

    desired = "#{action}@#{new_ref}"
    desired += " # v#{new_version}" unless new_version.empty?
    old_pin = pins.fetch(action)
    desired = old_pin if version_comment_downgrade?(old_pin, desired)
    return nil if old_pin == desired

    {
      action: action,
      old_pin: old_pin,
      new_pin: desired
    }
  end

  def source_pin_replacements(pins, desired_pins)
    source_pin_records.each_with_object({}) do |record, replacements|
      action = record.fetch(:action)
      next unless pins.key?(action)

      old_pin = record.fetch(:pin)
      new_pin = desired_pins.fetch(action)
      next if old_pin == new_pin

      replacements[old_pin] = {
        action: action,
        old_pin: old_pin,
        new_pin: new_pin
      }
    end
  end

  def desired_pins_by_action(pins, replacements)
    replacements.values.each_with_object(pins.dup) do |replacement, desired|
      desired[replacement.fetch(:action)] = replacement.fetch(:new_pin)
    end
  end

  def pin_action_key(change, pins)
    action = change.fetch("action")
    return action if pins.key?(action)

    old_value = change["old_value"].to_s
    old_action, separator, = old_value.partition("@")
    return old_action if separator == "@" && pins.key?(old_action)

    action
  end

  def version_comment_downgrade?(old_pin, desired_pin)
    old = parse_pin(old_pin)
    desired = parse_pin(desired_pin)
    return false unless old && desired
    return false unless old.fetch(:ref) == desired.fetch(:ref)

    old_version = parsed_comment_version(old.fetch(:version))
    desired_version = parsed_comment_version(desired.fetch(:version))
    return false unless old_version && desired_version
    return false unless old_version == desired_version

    version_comment_specificity(old.fetch(:version)) > version_comment_specificity(desired.fetch(:version))
  end

  def parsed_comment_version(version)
    value = version.to_s.delete_prefix("v")
    return nil if value.empty?

    Gem::Version.new(value)
  rescue ArgumentError
    nil
  end

  def version_comment_specificity(version)
    version.to_s.delete_prefix("v").split(".").count { |part| part.match?(/\A\d+\z/) }
  end

  def apply_replacements(replacements)
    source_paths.each do |path|
      original = File.read(path)
      updated = replacements.reduce(original) do |content, replacement|
        content.gsub(replacement.fetch(:old_pin), replacement.fetch(:new_pin))
      end
      File.write(path, updated) if updated != original
    end
  end

  def replacement_target_paths(replacements)
    return [] if replacements.empty?

    source_paths.select do |path|
      original = File.read(path)
      replacements.any? { |replacement| original.include?(replacement.fetch(:old_pin)) }
    end.map { |path| project_relative_path(path) }.uniq.sort
  end

  def replacement_changes(replacements, planned_changes)
    planned_by_action = planned_changes.each_with_object({}) do |change, result|
      result[pin_action_key(change, Kettle::Jem.github_actions_step_pins)] = change
    end
    replacements.values.sort_by { |replacement| replacement.fetch(:action) }.map do |replacement|
      old_pin = parse_pin(replacement.fetch(:old_pin)) || {}
      new_pin = parse_pin(replacement.fetch(:new_pin)) || {}
      planned = planned_by_action[replacement.fetch(:action)] || {}
      {
        action: replacement.fetch(:action),
        old_ref: old_pin[:ref].to_s,
        old_version: old_pin[:version].to_s,
        new_ref: new_pin[:ref].to_s,
        new_version: new_pin[:version].to_s,
        reason: planned.fetch("reason", "synchronize_template_pin")
      }
    end
  end

  def changelog_path
    "CHANGELOG.md"
  end

  def changelog_needed?(replacements)
    @options[:write] && @options[:changelog] && replacements.any?
  end

  def add_changelog_entry(changes)
    Kettle::Jem::MaintenanceChangelog.upsert_unreleased_entry(
      project_root: @project_root,
      section: "Changed",
      key: CHANGELOG_KEY,
      legacy_prefixes: [LEGACY_CHANGELOG_PREFIX],
      entry: ->(existing_entries) { workflow_changelog_entry(changes, existing_entries: existing_entries) }
    )
  end

  def workflow_changelog_entry(changes, existing_entries: [])
    existing_baselines = workflow_changelog_baselines(existing_entries)
    details = changes.group_by { |change| change.fetch(:action) }.sort.map do |action, grouped|
      latest = grouped.max_by { |change| Gem::Version.new(change.fetch(:new_version).to_s) }
      baseline = existing_baselines.fetch(action, {
        old_version: latest.fetch(:old_version),
        old_ref: latest.fetch(:old_ref)
      })
      "#{action} #{self.class.pin_label(baseline.fetch(:old_version), baseline.fetch(:old_ref))} -> " \
        "#{self.class.pin_label(latest.fetch(:new_version), latest.fetch(:new_ref))}"
    end
    "Update pinned GitHub Actions in kettle-jem templates:\n#{details.map { |detail| "  - #{detail}" }.join("\n")}"
  end

  def workflow_changelog_baselines(existing_entries)
    pattern = /([\w.-]+\/[\w.-]+(?:\/[\w.-]+)*)\s+(v?[\d.]+)\s+\(([0-9a-f]{40})\)\s+->\s+(v?[\d.]+)\s+\(([0-9a-f]{40})\)/
    Array(existing_entries).flat_map { |entry| entry.fetch(:source).to_s.lines }.each_with_object({}) do |line, baselines|
      line.scan(pattern).each do |action, old_version, old_ref, _new_version, _new_ref|
        baselines[action] ||= {old_version: old_version, old_ref: old_ref}
      end
    end
  end

  def human_join(values)
    return values.fetch(0) if values.length == 1
    return values.join(" and ") if values.length == 2

    "#{values[0...-1].join(", ")}, and #{values[-1]}"
  end

  def preexisting_dirty_target_paths(relative_paths)
    return [] if relative_paths.empty? || !git_repository?

    dirty_paths(relative_paths)
  end

  def commit_changes(relative_paths, preexisting_dirty_paths)
    return {status: "skipped", reason: "no_updates"} if relative_paths.empty?
    return {status: "unavailable", reason: "not_git_repository"} unless git_repository?
    unless preexisting_dirty_paths.empty?
      raise "Refusing to commit workflow pin updates because target files were already dirty: #{preexisting_dirty_paths.join(", ")}"
    end

    changed_paths = dirty_paths(relative_paths)
    return {status: "clean_noop", reason: "no_file_changes"} if changed_paths.empty?

    run_git!("add", "--", *changed_paths.map { |path| worktree_relative_path(path) })
    run_git!("commit", "-m", "📌 Update kettle-jem workflow pins")
    {status: "committed", files: changed_paths}
  end

  def git_repository?
    !!git_worktree_root
  end

  def dirty_paths(relative_paths)
    stdout, _stderr, _status = Open3.capture3("git", "status", "--porcelain", "--", *relative_paths, chdir: @project_root)
    stdout.lines.filter_map do |line|
      path = line[3..].to_s.chomp
      next if path.empty?

      project_relative_path(path)
    end
  end

  def run_git!(*args)
    stdout, stderr, status = Open3.capture3("git", *args, chdir: git_worktree_root || @project_root)
    return stdout if status.success?

    raise "git #{args.join(" ")} failed: #{stderr.empty? ? stdout : stderr}"
  end

  def git_worktree_root
    stdout, _stderr, status = Open3.capture3("git", "rev-parse", "--show-toplevel", chdir: @project_root)
    return unless status.success?

    stdout.strip unless stdout.strip.empty?
  end

  def project_relative_path(path)
    return path if File.file?(File.join(@project_root, path))

    absolute_path = (File.absolute_path(path) == path) ? path : File.expand_path(path, git_worktree_root || @project_root)
    Pathname(absolute_path).relative_path_from(Pathname(@project_root)).to_s
  rescue ArgumentError
    path
  end

  def worktree_relative_path(path)
    Pathname(File.join(@project_root, path)).relative_path_from(Pathname(git_worktree_root || @project_root)).to_s
  end
end

exit(KettleJemWorkflowPins.run(ARGV, env: ENV, out: $stdout, err: $stderr)) if $PROGRAM_NAME == __FILE__
