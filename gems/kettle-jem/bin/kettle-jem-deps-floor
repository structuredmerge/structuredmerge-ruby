#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "fileutils"
require "open3"
require "optparse"
require "pathname"
require "time"

# Repository-local executable must boot from the unreleased source checkout.
# rubocop:disable Packaging/RequireRelativeHardcodingLib -- Installed execution is not available while maintaining templates.
require_relative "../lib/kettle/jem"
# rubocop:enable Packaging/RequireRelativeHardcodingLib

# Repository-local maintenance tool for updating dependency floors owned by
# kettle-jem templates.
class KettleJemDepsFloor
  VALID_UPGRADE_LEVELS = %w[major minor patch].freeze
  DEFAULT_UPGRADE_LEVEL = "major"
  DEFAULT_PROJECT_ROOT = File.expand_path("..", __dir__)
  CHANGELOG_KEY = "kettle-jem-deps-floor"
  LEGACY_CHANGELOG_PREFIX = "Update kettle-jem template dependency floors:"
  CACHE_TTL_SECONDS = 30 * 24 * 60 * 60
  CACHE_ENV_KEY = "KETTLE_JEM_DEPS_FLOOR_CACHE"
  CACHE_REFRESH_ENV_KEY = "KETTLE_JEM_DEPS_FLOOR_CACHE_REFRESH"
  RUBYGEMS_REFRESH_ENV_KEY = "KETTLE_RUBYGEMS_REFRESH"
  RELEASE_MARKER_ENV_KEY = "KETTLE_RUBYGEMS_CACHE_BUST_PATH"

  SOURCE_GLOBS = [
    "lib/kettle/jem/templates/Appraisal.root.gemfile.example",
    "lib/kettle/jem/templates/Appraisals.example",
    "lib/kettle/jem/templates/Gemfile.example",
    "lib/kettle/jem/templates/gem.gemspec.example",
    "lib/kettle/jem/templates/gemfiles/**/*.gemfile.example",
    "lib/kettle/jem/templates/shim/Gemfile.example",
    "lib/kettle/jem/templates/shim/gem.gemspec.example"
  ].freeze
  EXTRA_SOURCE_FILES = [
    "lib/kettle/jem.rb"
  ].freeze

  class PersistentRubyGemsResolver
    def initialize(delegate: Kettle::Jem::RubyGemsResolver.new, cache_path: KettleJemDepsFloor.default_cache_path, marker_path: KettleJemDepsFloor.default_release_marker_path, clock: -> { Time.now.utc })
      @delegate = delegate
      @cache_path = cache_path.to_s
      @marker_path = marker_path.to_s
      @clock = clock
    end

    def versions(gem_name, include_prerelease: false, requirements: nil)
      requirement = Gem::Requirement.new(requirements || [">= 0"])
      all_versions(gem_name).filter_map do |entry|
        number = (entry[:number] || entry["number"]).to_s
        next if number.empty?
        next if !include_prerelease && truthy_entry_value?(entry[:prerelease] || entry["prerelease"])
        next unless requirement.satisfied_by?(Gem::Version.new(number))

        entry.transform_keys(&:to_sym).merge(number: number)
      end.sort_by { |entry| Gem::Version.new(entry.fetch(:number)) }
    end

    private

    attr_reader :delegate, :cache_path, :marker_path, :clock

    def all_versions(gem_name)
      name = gem_name.to_s
      cached = cached_versions(name)
      return cached if cached && !refresh_requested? && !fresh_release_marker?(name)

      live = delegate.versions(name, include_prerelease: true, requirements: nil)
      write_versions(name, live)
      live
    rescue => error
      return cached if cached

      raise error
    end

    def cached_versions(gem_name)
      entry = read_cache.fetch("versions", {})[gem_name]
      return unless entry.is_a?(Hash)
      return unless fresh_cache_entry?(entry)

      Array(entry["entries"])
    end

    def write_versions(gem_name, entries)
      return if cache_path.empty?

      data = read_cache
      data["versions"] ||= {}
      data["versions"][gem_name] = {
        "cached_at" => clock.call.utc.iso8601,
        "entries" => entries
      }
      FileUtils.mkdir_p(File.dirname(cache_path))
      File.write(cache_path, JSON.pretty_generate(data) << "\n")
    end

    def read_cache
      return {} if cache_path.empty? || !File.file?(cache_path)

      parsed = JSON.parse(File.read(cache_path))
      parsed.is_a?(Hash) ? parsed : {}
    rescue JSON::ParserError
      {}
    end

    def fresh_cache_entry?(entry)
      cached_at = Time.iso8601(entry["cached_at"].to_s)
      cached_at >= clock.call.utc - CACHE_TTL_SECONDS
    rescue ArgumentError
      false
    end

    def fresh_release_marker?(gem_name)
      entry = read_release_marker.fetch("releases", {})[gem_name]
      return false unless entry

      released_at = Time.iso8601(entry["released_at"].to_s)
      released_at >= clock.call.utc - CACHE_TTL_SECONDS
    rescue ArgumentError
      false
    end

    def read_release_marker
      return {} if marker_path.empty? || !File.file?(marker_path)

      parsed = JSON.parse(File.read(marker_path))
      parsed.is_a?(Hash) ? parsed : {}
    rescue JSON::ParserError
      {}
    end

    def refresh_requested?
      truthy_env?(CACHE_REFRESH_ENV_KEY) || truthy_env?(RUBYGEMS_REFRESH_ENV_KEY)
    end

    def truthy_env?(key)
      ENV.fetch(key, "").match?(/\A(?:1|true|yes|on|enabled)\z/i)
    end

    def truthy_entry_value?(value)
      value == true || value.to_s.match?(/\A(?:1|true|yes|on)\z/i)
    end
  end

  def initialize(project_root:, resolver: self.class.default_resolver, options: {})
    @project_root = File.expand_path(project_root)
    @resolver = resolver
    @options = {
      write: false,
      check: false,
      commit: true,
      changelog: true,
      json: false,
      upgrade: DEFAULT_UPGRADE_LEVEL
    }.merge(options.transform_keys(&:to_sym))
  end

  def self.run(argv = ARGV, out: $stdout, err: $stderr)
    options = parse_options(argv)
    result = new(project_root: options.delete(:project_root), options: options).run
    if options[:json]
      out.puts(JSON.pretty_generate(result))
    else
      out.puts("deps-floor: mode=#{result.fetch(:mode)} upgrade=#{result.fetch(:upgrade)}")
      out.puts("deps-floor: #{result.fetch(:updates)} update#{"s" unless result.fetch(:updates) == 1}")
      result.fetch(:planned_changes, []).each do |change|
        out.puts(
          "  #{change.fetch(:name)} #{change.fetch(:relative_path)} " \
            "#{change.fetch(:current_pessimistic)}, >= #{change.fetch(:current_floor)} -> " \
            "#{change.fetch(:new_pessimistic)}, >= #{change.fetch(:new_floor)}"
        )
      end
      if result[:changelog]
        out.puts("changelog: #{result.fetch(:changelog).fetch(:status)}")
      end
      if result[:commit]
        out.puts("commit: #{result.fetch(:commit).fetch(:status)}")
      elsif !result.fetch(:mode).to_s.eql?("write") && result.fetch(:updates).positive?
        out.puts("hint: rerun with --write --upgrade #{result.fetch(:upgrade)} to apply and commit these updates")
      end
    end
    0
  rescue OptionParser::ParseError, ArgumentError => error
    err.puts(error.message)
    err.puts(parser)
    2
  rescue => error
    err.puts("#{error.class}: #{error.message}")
    1
  end

  def self.parse_options(argv)
    options = {
      project_root: DEFAULT_PROJECT_ROOT,
      write: false,
      check: false,
      commit: true,
      changelog: true,
      json: false,
      upgrade: DEFAULT_UPGRADE_LEVEL
    }
    parser.parse!(argv, into: options)
    options[:project_root] = argv.shift || DEFAULT_PROJECT_ROOT
    raise OptionParser::InvalidArgument, "Expected at most one PROJECT_ROOT" unless argv.empty?

    options
  end

  def self.parser
    OptionParser.new do |opts|
      opts.banner = "Usage: bin/kettle-jem-deps-floor [PROJECT_ROOT] [--json] [--write] [--check] [--commit|--no-commit] [--changelog|--no-changelog] [--upgrade LEVEL]"
      opts.on("-w", "--write", "Write updates to kettle-jem template sources.") { |value| value }
      opts.on("--check", "Fail when managed dependency floors are stale.") { |value| value }
      opts.on("--[no-]commit", "Commit written updates (default with --write).") { |value| value }
      opts.on("--[no-]changelog", "Add a Changed entry with kettle-changelog (default with --write).") { |value| value }
      opts.on("--json", "Print the machine-readable report as JSON.") { |value| value }
      opts.on("--upgrade LEVEL", "Upgrade strategy: major, minor, patch (default: #{DEFAULT_UPGRADE_LEVEL})") { |value| value }
    end
  end

  def self.default_resolver
    PersistentRubyGemsResolver.new
  end

  def self.default_cache_path
    configured = ENV.fetch(CACHE_ENV_KEY, "").to_s
    return "" if configured.match?(/\A(?:false|0|no|off|disabled)\z/i)
    return configured unless configured.empty?

    cache_home = ENV["XDG_CACHE_HOME"]
    cache_home = File.join(Dir.home, ".cache") if cache_home.to_s.empty?
    File.join(cache_home, "kettle-jem", "deps-floor-rubygems-versions.json")
  end

  def self.default_release_marker_path
    configured = ENV.fetch(RELEASE_MARKER_ENV_KEY, "").to_s
    return configured unless configured.empty?

    state_home = ENV["XDG_STATE_HOME"]
    state_home = File.join(Dir.home, ".local", "state") if state_home.to_s.empty?
    File.join(state_home, "kettle-dev", "rubygems-cache-bust.json")
  end

  def run
    upgrade = @options.fetch(:upgrade, DEFAULT_UPGRADE_LEVEL).to_s
    unless VALID_UPGRADE_LEVELS.include?(upgrade)
      raise ArgumentError, "Invalid --upgrade value #{upgrade.inspect}; use one of: #{VALID_UPGRADE_LEVELS.join(", ")}"
    end

    records = dependency_records
    planned_changes = planned_dependency_changes(records, upgrade)
    target_paths = changed_relative_paths(planned_changes)
    target_paths << changelog_path if changelog_needed?(planned_changes)
    preexisting_dirty_paths = preexisting_dirty_target_paths(target_paths)
    changelog_result = add_changelog_entry(planned_changes) if changelog_needed?(planned_changes)
    apply_changes(planned_changes) if @options[:write] && planned_changes.any?
    commit_result = commit_changes(target_paths, preexisting_dirty_paths) if @options[:write] && @options[:commit] && planned_changes.any?

    if @options[:check] && planned_changes.any?
      raise "Managed dependency floors are stale; run bin/kettle-jem-deps-floor --write --upgrade #{upgrade}"
    end

    {
      mode: @options[:write] ? "write" : "dry-run",
      check: !!@options[:check],
      upgrade: upgrade,
      discovered_dependencies: records.map { |record| record.fetch(:name) }.uniq.sort,
      updates: planned_changes.length,
      updated_dependencies: planned_changes.map { |change| change.fetch(:name) }.uniq.sort,
      commit: commit_result,
      changelog: changelog_result,
      planned_changes: planned_changes.map { |change| serializable_change(change) }
    }
  end

  private

  attr_reader :project_root, :resolver

  def dependency_records
    dedupe_records(dependency_source_paths.flat_map { |relative_path| dependency_records_for_path(relative_path) })
  end

  def dependency_source_paths
    paths = self.class::SOURCE_GLOBS.flat_map do |pattern|
      Dir.glob(File.join(project_root, pattern), File::FNM_DOTMATCH).select { |path| File.file?(path) }
    end
    paths.concat(self.class::EXTRA_SOURCE_FILES.map { |relative_path| File.join(project_root, relative_path) })
    paths.uniq.sort.map { |path| Pathname(path).relative_path_from(Pathname(project_root)).to_s }
  end

  def dependency_records_for_path(relative_path)
    path = File.join(project_root, relative_path)
    content = File.read(path)
    [
      *ruby_dependency_records(content, relative_path),
      *text_dependency_records(content, relative_path)
    ]
  end

  def ruby_dependency_records(content, relative_path)
    [
      *ruby_call_dependency_records(content, relative_path),
      *ruby_requirement_assignment_records(content, relative_path)
    ]
  end

  def ruby_call_dependency_records(content, relative_path)
    Kettle::Jem.ruby_call_records(content, nil).filter_map do |call|
      next unless ruby_dependency_call?(call)

      name = Kettle::Jem.ruby_string_argument(call)
      next unless real_gem_name?(name)

      requirement_arguments = Array(call.arguments&.arguments).drop(1).select do |argument|
        argument.is_a?(::Prism::StringNode)
      end
      record_from_arguments(relative_path, name, requirement_arguments, source_kind: "ruby")
    end
  end

  def ruby_dependency_call?(call)
    return true if call.receiver.nil? && call.name == :gem
    return true if %i[add_dependency add_runtime_dependency add_development_dependency].include?(call.name)

    false
  end

  def ruby_requirement_assignment_records(content, relative_path)
    result = Kettle::Jem.prism_parse_success(content)
    return [] unless result

    result.value.breadth_first_search_all do |node|
      node.is_a?(::Prism::LocalVariableWriteNode) &&
        %i[nomono_requirements nomono_activation_requirements].include?(node.name)
    end.filter_map do |node|
      values = Array(node.value&.elements).select { |element| element.is_a?(::Prism::StringNode) }
      record_from_arguments(relative_path, "nomono", values, source_kind: "ruby")
    end
  end

  def record_from_arguments(relative_path, name, arguments, source_kind:)
    return unless real_gem_name?(name)

    pessimistic = arguments.find { |argument| Kettle::Jem.ruby_static_string_value(argument).to_s.start_with?("~>") }
    floor = arguments.find { |argument| Kettle::Jem.ruby_static_string_value(argument).to_s.start_with?(">=") }
    return unless pessimistic && floor

    {
      relative_path: relative_path,
      name: name,
      source_kind: source_kind,
      current_pessimistic: Kettle::Jem.ruby_static_string_value(pessimistic),
      current_floor: Kettle::Jem.ruby_static_string_value(floor),
      pessimistic_range: range_for(pessimistic),
      floor_range: range_for(floor)
    }
  end

  def range_for(node)
    {
      start_offset: node.location.start_offset,
      end_offset: node.location.end_offset
    }
  end

  def text_dependency_records(content, relative_path)
    lines = content.lines
    lines.each_with_index.filter_map do |line, index|
      name = text_dependency_name(line)
      next unless real_gem_name?(name)

      current_pessimistic, pessimistic_range = text_requirement_record(content, lines, index, line, "~>")
      current_floor, floor_range = text_requirement_record(content, lines, index, line, ">=")
      next unless current_pessimistic && current_floor

      {
        relative_path: relative_path,
        name: name,
        source_kind: "text",
        current_pessimistic: current_pessimistic,
        current_floor: current_floor,
        pessimistic_range: pessimistic_range,
        floor_range: floor_range
      }
    end
  end

  def text_dependency_name(line)
    stripped = line.lstrip
    return if stripped.start_with?("#")
    return "nomono" if stripped.start_with?("nomono_requirements =", "nomono_activation_requirements =")

    match = stripped.match(/\A(?:gem|spec\.add_dependency|spec\.add_runtime_dependency|spec\.add_development_dependency)\(?\s*"([^"]+)"/)
    return match[1] if match

    match = stripped.match(/(?:source:\s*)?%\(gem "([^"]+)"/)
    match && match[1]
  end

  def real_gem_name?(name)
    name.to_s.match?(/\A[a-zA-Z0-9_.-]+\z/)
  end

  def text_requirement_record(content, lines, index, line, operator)
    match = line.match(/"#{Regexp.escape(operator)} [^"]+"/)
    return unless match

    line_start = lines.take(index).join.bytesize
    value = match[0][1...-1]
    [
      value,
      {
        start_offset: line_start + match.begin(0),
        end_offset: line_start + match.end(0)
      }
    ]
  end

  def dedupe_records(records)
    seen = {}
    records.select do |record|
      key = [
        record.fetch(:relative_path),
        record.fetch(:name),
        record.fetch(:pessimistic_range).fetch(:start_offset),
        record.fetch(:floor_range).fetch(:start_offset)
      ]
      next false if seen.include?(key)

      seen[key] = true
      true
    end
  end

  def planned_dependency_changes(records, upgrade)
    records.filter_map do |record|
      current_floor = floor_version(record.fetch(:current_floor))
      latest = latest_version_for(record.fetch(:name), current_floor, upgrade)
      next unless latest && latest > current_floor

      {
        **record,
        current_floor_version: current_floor,
        new_floor_version: latest,
        new_pessimistic: pessimistic_requirement_for(latest)
      }
    end
  end

  def latest_version_for(name, current_floor, upgrade)
    resolver.versions(name, requirements: requirement_for_upgrade(current_floor, upgrade)).map do |entry|
      Gem::Version.new((entry[:number] || entry["number"]).to_s)
    end.max
  end

  def requirement_for_upgrade(current_floor, upgrade)
    major = current_floor.segments.fetch(0)
    minor = current_floor.segments.fetch(1, 0)
    case upgrade
    when "patch"
      [">= #{current_floor}", "~> #{major}.#{minor}.0"]
    when "minor"
      [">= #{current_floor}", "~> #{major}.0"]
    else
      [">= #{current_floor}"]
    end
  end

  def floor_version(requirement)
    parsed = Gem::Requirement.new(requirement).requirements.find { |operator, _version| operator == ">=" }
    raise ArgumentError, "Expected >= requirement, got #{requirement.inspect}" unless parsed

    parsed.last
  end

  def pessimistic_requirement_for(version)
    segments = version.segments
    "~> #{segments.fetch(0)}.#{segments.fetch(1, 0)}"
  end

  def apply_changes(changes)
    changes.group_by { |change| change.fetch(:relative_path) }.each do |relative_path, path_changes|
      path = File.join(project_root, relative_path)
      replacements = path_changes.flat_map do |change|
        [
          change.fetch(:pessimistic_range).merge(replacement: JSON.generate(change.fetch(:new_pessimistic))),
          change.fetch(:floor_range).merge(replacement: JSON.generate(">= #{change.fetch(:new_floor_version)}"))
        ]
      end
      original = File.read(path)
      updated = Kettle::Jem.replace_source_offsets(original, replacements)
      File.write(path, updated) if updated != original
    end
  end

  def preexisting_dirty_target_paths(relative_paths)
    return [] if relative_paths.empty? || !git_repository?

    dirty_paths(relative_paths)
  end

  def commit_changes(relative_paths, preexisting_dirty_paths)
    return {status: "skipped", reason: "no_updates"} if relative_paths.empty?
    return {status: "unavailable", reason: "not_git_repository"} unless git_repository?
    unless preexisting_dirty_paths.empty?
      raise "Refusing to commit dependency floor updates because target files were already dirty: #{preexisting_dirty_paths.join(", ")}"
    end

    changed_paths = dirty_paths(relative_paths)
    return {status: "clean_noop", reason: "no_file_changes"} if changed_paths.empty?

    run_git!("add", "--", *changed_paths.map { |path| worktree_relative_path(path) })
    run_git!("commit", "-m", "⬆️ Raise kettle-jem dependency floors")
    {status: "committed", files: changed_paths}
  end

  def changed_relative_paths(changes)
    changes.map { |change| change.fetch(:relative_path) }.uniq.sort
  end

  def changelog_path
    "CHANGELOG.md"
  end

  def changelog_needed?(changes)
    @options[:write] && @options[:changelog] && changes.any?
  end

  def add_changelog_entry(changes)
    Kettle::Jem::MaintenanceChangelog.upsert_unreleased_entry(
      project_root: project_root,
      section: "Changed",
      key: CHANGELOG_KEY,
      legacy_prefixes: [LEGACY_CHANGELOG_PREFIX],
      entry: ->(existing_entries) { dependency_changelog_entry(changes, existing_entries: existing_entries) }
    )
  end

  def dependency_changelog_entry(changes, existing_entries: [])
    existing_baselines = dependency_changelog_baselines(existing_entries)
    details = changes.group_by { |change| change.fetch(:name) }.sort.map do |name, grouped|
      current_versions = grouped.map { |change| change.fetch(:current_floor_version) }
      new_versions = grouped.map { |change| change.fetch(:new_floor_version) }
      initial = [*existing_baselines[name], *current_versions].map { |version| Gem::Version.new(version.to_s) }.min
      latest = new_versions.map { |version| Gem::Version.new(version.to_s) }.max
      "#{name} (>= #{initial} -> >= #{latest})"
    end
    "Update kettle-jem template dependency floors:\n#{details.map { |detail| "  - #{detail}" }.join("\n")}"
  end

  def dependency_changelog_baselines(existing_entries)
    Array(existing_entries).flat_map { |entry| entry.fetch(:source).to_s.lines }.each_with_object(Hash.new { |hash, key| hash[key] = [] }) do |line, baselines|
      line.scan(/\b([A-Za-z0-9_.-]+)\s+\(>=\s*([0-9A-Za-z.+-]+)/).each do |name, version|
        baselines[name] << Gem::Version.new(version)
      end
    end
  end

  def human_join(values)
    return values.fetch(0) if values.length == 1
    return values.join(" and ") if values.length == 2

    "#{values[0...-1].join(", ")}, and #{values[-1]}"
  end

  def git_repository?
    !!git_worktree_root
  end

  def dirty_paths(relative_paths)
    stdout, _stderr, _status = Open3.capture3("git", "status", "--porcelain", "--", *relative_paths, chdir: project_root)
    stdout.lines.filter_map do |line|
      path = line[3..].to_s.chomp
      next if path.empty?

      project_relative_path(path)
    end
  end

  def run_git!(*args)
    stdout, stderr, status = Open3.capture3("git", *args, chdir: git_worktree_root || project_root)
    return stdout if status.success?

    raise "git #{args.join(" ")} failed: #{stderr.empty? ? stdout : stderr}"
  end

  def git_worktree_root
    stdout, _stderr, status = Open3.capture3("git", "rev-parse", "--show-toplevel", chdir: project_root)
    return unless status.success?

    stdout.strip unless stdout.strip.empty?
  end

  def project_relative_path(path)
    return path if File.file?(File.join(project_root, path))

    absolute_path = File.expand_path(path, git_worktree_root || project_root)
    Pathname(absolute_path).relative_path_from(Pathname(project_root)).to_s
  rescue ArgumentError
    path
  end

  def worktree_relative_path(path)
    Pathname(File.join(project_root, path)).relative_path_from(Pathname(git_worktree_root || project_root)).to_s
  end

  def serializable_change(change)
    {
      name: change.fetch(:name),
      relative_path: change.fetch(:relative_path),
      source_kind: change.fetch(:source_kind),
      current_pessimistic: change.fetch(:current_pessimistic),
      new_pessimistic: change.fetch(:new_pessimistic),
      current_floor: change.fetch(:current_floor_version).to_s,
      new_floor: change.fetch(:new_floor_version).to_s
    }
  end
end

exit(KettleJemDepsFloor.run(ARGV, out: $stdout, err: $stderr)) if $PROGRAM_NAME == __FILE__
