# frozen_string_literal: true

# Local path overrides for templating development.
# Loaded by the associated non-local gemfile when STRUCTUREDMERGE_DEV or KETTLE_DEV_DEV
# is not "false".

{KJ|LOCAL_GEMFILE_NOMONO_BOOTSTRAP}

# Declared dependency requirements, supplied by project facts.
local_gem_requirements = {KJ|LOCAL_GEM_REQUIREMENTS}

structuredmerge_local_gems = %w[
  tree_haver
  ast-merge
  config-merge
  ast-crispr
  ast-crispr-ruby-prism
  ast-crispr-markdown-markly
  ast-crispr-toml
  ast-crispr-yaml-psych
  ast-merge-git
  plain-merge
  bash-merge
  dotenv-merge
  rbs-merge
  html-merge
  json-merge
  yaml-merge
  toml-merge
  markdown-merge
  ruby-merge
  go-merge
  rust-merge
  typescript-merge
  ast-template
  binary-merge
  zip-merge
  psych-merge
  citrus-toml-merge
  parslet-toml-merge
  commonmarker-merge
  kramdown-merge
  markly-merge
  prism-merge
  kettle-jem
  smorg-rb
]

kettle_dev_local_gems = %w[
  {KJ|KETTLE_DEV_LOCAL_GEMS}
]
shared_nomono_options = {
  vendored_gems_env: "VENDORED_GEMS",
  vendor_gem_dir_env: "VENDOR_GEM_DIR"
}
kettle_dev_nomono_options = shared_nomono_options.merge(
  prefix: "KETTLE_DEV",
  path_env: "KETTLE_DEV_DEV",
  debug_env: "KETTLE_DEV_DEBUG",
  root: ["src", "my", "kettle-dev"]
)
structuredmerge_nomono_options = shared_nomono_options.merge(
  prefix: "STRUCTUREDMERGE",
  path_env: "STRUCTUREDMERGE_DEV",
  debug_env: "STRUCTUREDMERGE_DEBUG"
)
structuredmerge_local_gems_to_eval = structuredmerge_local_gems - %w[{KJ|PACKAGE_NAME}]

if ENV.fetch("STRUCTUREDMERGE_DEV", "false").casecmp("false") != 0
  eval_nomono_gems(
    gems: structuredmerge_local_gems_to_eval,
    requirements: local_gem_requirements,
    **structuredmerge_nomono_options
  )
end

if ENV.fetch("KETTLE_DEV_DEV", "false").casecmp("false") != 0
  kettle_dev_local_gems_to_eval = kettle_dev_local_gems - %w[{KJ|PACKAGE_NAME}]

  eval_nomono_gems(
    gems: kettle_dev_local_gems_to_eval,
    requirements: local_gem_requirements,
    **kettle_dev_nomono_options
  )
end

# structuredmerge-core lives in a subdirectory of its own repository.
if ENV.fetch("STRUCTUREDMERGE_CORE_DEV", "false").casecmp("false") != 0
  eval_nomono_gems(
    gems: %w[structuredmerge-core],
    prefix: "STRUCTUREDMERGE_CORE",
    path_env: "STRUCTUREDMERGE_CORE_DEV",
    debug_env: "STRUCTUREDMERGE_CORE_DEBUG",
    root: %w[src my structuredmerge structuredmerge],
    subdirs: {"structuredmerge-core" => "packages/ruby"}
  )
end
