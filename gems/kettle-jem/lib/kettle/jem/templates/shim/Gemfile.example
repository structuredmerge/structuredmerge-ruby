# frozen_string_literal: true

source "https://gem.coop"

shimmed_gem_path = ENV["KETTLE_JEM_SHIMMED_GEM_PATH"].to_s
gem "{KJ|SHIMMED_GEM_NAME}", path: shimmed_gem_path unless shimmed_gem_path.empty?

# Local workspace dependency wiring for templating_local.gemfile overrides.
gem "nomono", "~> 1.0", ">= 1.0.6", require: false # ruby >= 2.2

# Templating (env-switched: SMORG_RB_DEV=/path/to/structuredmerge/ruby/gems for local paths)
eval_gemfile "gemfiles/modular/templating.gemfile" if ENV.fetch("K_JEM_TEMPLATING", "false").casecmp("true").zero?

gemspec
