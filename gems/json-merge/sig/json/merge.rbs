module Json
  module Merge
    class Provider
      def provider_id: () -> String
      def family: () -> String
      def capabilities: () -> Ast::Merge::provider_capabilities
      def analyze: (Ast::Merge::provider_request request) -> Ast::Merge::provider_result
      def diff2: (Ast::Merge::provider_request request) -> Ast::Merge::provider_result
      def merge2: (Ast::Merge::provider_request request) -> Ast::Merge::provider_result
      def merge3: (Ast::Merge::provider_request request) -> Ast::Merge::provider_result
    end

    class SourceLocator
      class Range < Data
        attr_reader start_line: Integer
        attr_reader end_line: Integer
      end

      def initialize: (String source, dialect: Symbol, ?backend: String | Symbol?) -> void
      def pair_range: (String path) -> Range?
    end

    def self.merge_provider: () -> Provider
    def self.register_provider!: (?replace: bool) -> Ast::Merge::_MergeProvider

    class ThreeWayDecision
      class State < Data
        attr_reader present: bool
        attr_reader value: untyped

        def self.present: (untyped value) -> State
        def self.missing: () -> State
        def to_h: () -> Hash[Symbol, untyped]
      end

      class Result < Data
        attr_reader state: State
        attr_reader conflicts: Array[Hash[Symbol, untyped]]
        attr_reader changes: Array[Hash[Symbol, untyped]]

        def present?: () -> bool
        def value: () -> untyped
        def conflicted?: () -> bool
      end

      def call: (base: untyped, ours: untyped, theirs: untyped) -> Result
    end

    module Version
      VERSION: String
    end
    VERSION: String
  end
end
