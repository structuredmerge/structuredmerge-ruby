# frozen_string_literal: true

# Pre-publication installed-artifact gate; released-package CI remains separate.
source 'https://gem.coop'
gem 'nomono', '~> 1.1', '>= 1.1.5', require: false
require 'nomono/bundler'
eval_nomono_gems(
  gems: %w[tree_haver],
  prefix: 'STRUCTUREDMERGE', path_env: 'STRUCTUREDMERGE_DEV',
  root: %w[src my structuredmerge ruby gems]
)
gem 'structuredmerge-core', '= 0.2.0'
gem 'kettle-test', '~> 2.0', '>= 2.0.21'
gem 'turbo_tests2', '~> 3.2', '>= 3.2.7'
gem 'rspec_junit_formatter'
gem 'anonymous_loader', '~> 0.1', '>= 0.1.3'
gem 'toml', '~> 0.3'
gem 'toml-rb', '~> 4.0'
