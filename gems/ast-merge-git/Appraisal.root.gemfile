# frozen_string_literal: true

# kettle-jem:freeze
# To retain chunks of comments & code during kettle-jem templating:
# Wrap custom sections with freeze markers (e.g., as above and below this comment chunk).
# kettle-jem will then preserve content between those markers across template runs.
# kettle-jem:unfreeze

source 'https://gem.coop'

# Shared baseline for the Appraisal2 CI lanes in this gem.
gemspec

gem 'nomono', '~> 1.1', '>= 1.1.18'

# Lockstep family gems: when STRUCTUREDMERGE_DEV points at the workspace gem
# directories, wire the exact-pinned sibling dependencies from local paths so
# this baseline stays resolvable while a lockstep version is bumped but not
# yet published (the aggregate validation run happens before the cohort
# publishes, so registry-only resolution races unpublished pins such as
# tree_haver = 7.1.18 against a registry that still only has 7.1.17).
# Mirrors the lockstep wiring in .github/typed_core.gemfile; registry-only
# resolution (toggle unset) remains the default for local development and
# post-publication runs.
structuredmerge_dev_root = ENV.fetch('STRUCTUREDMERGE_DEV', '')
if !structuredmerge_dev_root.empty? && !%w[false 0 no off].include?(structuredmerge_dev_root.downcase)
  %w[ast-merge tree_haver].each do |lockstep_name|
    lockstep_path = File.join(structuredmerge_dev_root, lockstep_name)
    if File.directory?(lockstep_path) && File.exist?(File.join(lockstep_path, "#{lockstep_name}.gemspec"))
      gem lockstep_name, path: lockstep_path
    end
  end
end

if respond_to?(:generator_only)
  generator_only do
    eval_gemfile 'gemfiles/modular/templating.gemfile' if ENV.fetch('K_JEM_TEMPLATING', 'false').casecmp('true').zero?
  end
end
# kettle-jem:freeze
# The lockstep tree_haver depends on structuredmerge-core ~> 0.2, which no
# registry carries before the kernel publishes. Appraisal's root resolution
# runs under plain Bundler, where generator_only is unavailable, so wire core
# from the local kernel checkout through the modular templating gemfile
# whenever the family dev env is engaged. Without that env the modular file
# retains registry mode, and published gems resolve normally.
if !respond_to?(:generator_only) && (ENV.fetch('K_JEM_TEMPLATING', 'false').casecmp('true').zero? ||
     !ENV.fetch('STRUCTUREDMERGE_DEV', '').strip.empty?)
  eval_gemfile 'gemfiles/modular/templating.gemfile'
end
# kettle-jem:unfreeze
