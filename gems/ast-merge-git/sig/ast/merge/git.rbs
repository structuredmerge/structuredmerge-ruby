module Ast
  module Merge
    module Git
      module Version
        VERSION: String
      end
      VERSION: String

      PACKAGE_NAME: String
      EXIT_SUCCESS: Integer
      EXIT_CONFLICT: Integer
      EXIT_ERROR: Integer
      CONFLICT_POLICIES: Array[Symbol]
      ADAPTER_ERROR_CATEGORIES: Array[Symbol]

      def self.merge3: (Hash[Symbol | String, untyped] request) -> Hash[Symbol, untyped]
      def self.merge_files: (
        base_path: String | Pathname,
        ours_path: String | Pathname,
        theirs_path: String | Pathname,
        ?conflict_policy: Symbol | String,
        **untyped
      ) -> Hash[Symbol, untyped]
      def self.run: (Array[String] argv, ?env: Hash[String, String], ?stderr: IO) -> Integer
      def self.git_exit_code: (Hash[Symbol, untyped] result) -> Integer

      module BenchmarkAdapter
        REQUEST_SCHEMA: String
        RESPONSE_SCHEMA: String
        OPERATIONS: Array[String]
        SOURCE_ROLES: Hash[String, Array[String]]

        def self.serve: (?input: IO, ?output: IO) -> void
        def self.execute: (Hash[String, untyped] request) -> Hash[String, untyped]
        def self.encode_source: (String source) -> String
        def self.decode_source: (String encoded) -> String
      end

      class Corpus
        class Error < StandardError
        end

        CLASSIFICATIONS: Array[String]
        BACKLOG_STATUSES: Array[String]
        SHA_PATTERN: Regexp
        REQUIRED_CASE_KEYS: Array[String]

        attr_reader manifest: Hash[String, untyped]

        def self.load: (String path) -> Corpus
        def initialize: (Hash[String, untyped] manifest) -> void
        def validate!: () -> true
        def cases: (?String? case_id) -> Array[Hash[String, untyped]]
      end

      class CorpusRunner
        DEFAULT_TIMEOUT: Integer
        OUTCOMES: Array[String]

        def initialize: (
          corpus: Corpus,
          repository: String | Pathname,
          driver_path: String | Pathname,
          tmp_root: String | Pathname,
          ?timeout: Integer
        ) -> void
        def run: (?case_id: String?) -> Array[Hash[Symbol, untyped]]
      end

      class CorpusAcquirer
        def self.acquire: (
          corpus: Corpus,
          destination: String | Pathname,
          tmp_root: String | Pathname
        ) -> Pathname
      end

      class LocalBenchmark
        class Error < StandardError
        end

        SCHEMA: String
        CASE_SCHEMA: String
        OPERATIONS: Array[String]
        PARTITIONS: Array[String]
        EXPECTATIONS: Array[String]
        SEVERITIES: Array[String]
        PRESERVATION: Array[String]
        TRANSFORMATIONS: Array[String]
        ID_PATTERN: Regexp
        PROVENANCE_FIELDS: Array[String]
        SELECTOR_FIELDS: Array[String]
        INPUT_ROLES: Hash[String, Array[String]]
        PROFILE_POLICIES: Hash[String, Array[String]]

        attr_reader document: Hash[String, untyped]
        attr_reader corpus_digest: String
        attr_reader path: Pathname?

        def self.load: (String | Pathname path) -> LocalBenchmark
        def initialize: (Hash[String, untyped] document, ?path: (String | Pathname)?, ?corpus_digest: String?) -> void
        def validate!: () -> true
        def cases: () -> Array[Hash[String, untyped]]
        def select: (profile: String | Symbol, ?changed_paths: Array[String]) -> Hash[String, untyped]
        def case_by_id: (String id) -> Hash[String, untyped]
      end

      class LocalBenchmarkRunner
        DEFAULT_TIMEOUT: Integer
        MAX_WORKERS: Integer

        def initialize: (
          benchmark: LocalBenchmark,
          driver_path: String | Pathname,
          tmp_root: String | Pathname,
          ?timeout: Integer,
          ?competitor_paths: Hash[String, String | Pathname],
          ?workers: Integer
        ) -> void
        def run: (profile: String | Symbol, ?changed_paths: Array[String]) -> Hash[String, untyped]
        def performance: (
          profile: String | Symbol,
          ?changed_paths: Array[String],
          ?iterations: Integer
        ) -> Hash[String, untyped]
      end

      class BenchmarkAdapterSession
        attr_reader spawn_duration_ns: Integer?

        def initialize: (
          driver_path: String | Pathname,
          chdir: String | Pathname,
          timeout: Integer,
          ?env: Hash[String, String?]
        ) -> void
        def start: () -> BenchmarkAdapterSession
        def request: (Hash[String, untyped] payload) -> Hash[String, untyped]
        def close: () -> void
      end

      class LocalBenchmarkReport
        SUCCESS: Array[String]

        def self.build: (Hash[String, untyped] run) -> Hash[String, untyped]
        def initialize: (Hash[String, untyped] run) -> void
        def build: () -> Hash[String, untyped]
      end
    end
  end
end
